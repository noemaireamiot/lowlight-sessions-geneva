# Copy to .env.local and fill in the real values (.env.local is gitignored).

# MariaDB 10.11 hosted on Infomaniak.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# Signs the admin session cookie. At least 32 characters.
# Generate one with: openssl rand -base64 32
# Use a DIFFERENT value in production, and changing it logs everyone out.
AUTH_SECRET=""

# Where uploaded posters are written. Defaults to ./uploads, which is fine for
# local development. In production point it OUTSIDE the deployed directory so a
# redeploy cannot wipe it, e.g. /home/clients/<id>/uploads
UPLOADS_DIR=""

# Newsletter sign-ups are sent to Infomaniak, not stored in the database.
# Token: Infomaniak manager > Developer > API tokens, with the newsletter scope.
INFOMANIAK_API_TOKEN=""
# NUMERIC id of the newsletter domain, not the domain name (e.g. 6930).
# Find it via GET https://api.infomaniak.com/1/newsletters
INFOMANIAK_NEWSLETTER_DOMAIN_ID=""
