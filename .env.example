# Copy to .env.local and fill in the real values (.env.local is gitignored).

# MariaDB 10.11 hosted on Infomaniak.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# Signs the admin session cookie. At least 32 characters.
# Generate one with: openssl rand -base64 32
# Use a DIFFERENT value in production, and changing it logs everyone out.
AUTH_SECRET=""
